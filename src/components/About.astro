---
import SectionHeader from './SectionHeader.astro';
import { asset, inlineMd } from '../lib/utils';
import site from '../data/site.json';

// Annotations pointing at the portrait — each one restates a fact from the About text.
const notes = [
  {
    n: 1,
    text: '13 yrs · semiconductor industry',
    sub: 'ST Microelectronics',
    x: 0,
    y: 34,
    px: 195,
    py: 150,
    anchor: 'start',
  },
  {
    n: 2,
    text: '.NET developer since 2019',
    sub: 'Capgemini → Inetum',
    x: 520,
    y: 70,
    px: 325,
    py: 150,
    anchor: 'end',
  },
  {
    n: 3,
    text: 'AI-augmented workflow',
    sub: 'Copilot · Claude Code',
    x: 0,
    y: 384,
    px: 195,
    py: 280,
    anchor: 'start',
  },
  {
    n: 4,
    text: 'Expert DevOps · RNCP 7',
    sub: 'in progress',
    x: 520,
    y: 414,
    px: 325,
    py: 280,
    anchor: 'end',
  },
];
---

<section id="about" class="section" aria-labelledby="about-title">
  <SectionHeader index={1} stage="plan" title={site.about.heading} id="about" />

  <div class="grid">
    <div class="text">
      {site.about.paragraphs.map((p, i) => (
        <p class="reveal" style={`--delay:${i * 90}ms`} set:html={inlineMd(p)} />
      ))}
    </div>

    <figure class="portrait reveal" style="--delay:150ms" aria-hidden="true">
      <svg viewBox="0 0 520 460">
        <defs>
          <clipPath id="detail-clip">
            <circle cx="260" cy="215" r="92"></circle>
          </clipPath>
        </defs>
        <!-- detail circle (dash-dot) and centre lines -->
        <circle cx="260" cy="215" r="118" class="detail-ring"></circle>
        <path d="M125 215 H395 M260 81 V349" class="centre"></path>
        <circle cx="260" cy="215" r="96" class="photo-ring"></circle>
        <image
          href={asset(site.assets.profilePhoto)}
          x="168"
          y="123"
          width="184"
          height="184"
          clip-path="url(#detail-clip)"
          preserveAspectRatio="xMidYMid slice"
        />
        <text x="260" y="452" class="detail-tag">
          DETAIL A · scale 2:1
        </text>
        {notes.map((n) => (
          <g class="note" style={`--d:${n.n * 120}ms`}>
            <path
              d={`M${n.px} ${n.py} L${n.anchor === 'start' ? n.x + 214 : n.x - 214} ${n.y + 6} H${n.x}`}
              class="leader"
            />
            <circle cx={n.px} cy={n.py} r="3" class="dot" />
            <text x={n.x} y={n.y} text-anchor={n.anchor} class="n-text">
              {n.text}
            </text>
            <text x={n.x} y={n.y + 22} text-anchor={n.anchor} class="n-sub">
              {n.sub}
            </text>
          </g>
        ))}
      </svg>
    </figure>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .grid {
      grid-template-columns: 1.35fr 1fr;
      gap: 4rem;
    }
  }
  .text p {
    color: var(--text-muted);
    font-size: 1.04rem;
  }
  .text p + p {
    margin-top: 1.1rem;
  }
  .text p:first-child {
    color: var(--text);
    font-size: 1.12rem;
  }

  .portrait {
    margin: 0;
    width: min(100%, 520px);
    justify-self: center;
  }
  .portrait svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .detail-ring {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.2;
    stroke-dasharray: 22 5 3 5;
  }
  .centre {
    stroke: var(--ink-faint);
    stroke-dasharray: 16 4 2 4;
  }
  .photo-ring {
    fill: none;
    stroke: url(#brass-fill);
    stroke-width: 6;
  }
  image {
    filter: grayscale(0.35) sepia(0.15) contrast(1.05);
    transition: filter 0.6s ease;
  }
  .portrait:hover image {
    filter: none;
  }
  .detail-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-anchor: middle;
    fill: var(--ink-accent);
  }
  .leader {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1;
  }
  .dot {
    fill: var(--ink-accent);
  }
  .n-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 17px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    fill: var(--text);
  }
  .n-sub {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--text-muted);
  }
  .note {
    opacity: 0;
    transition: opacity 0.6s ease;
    transition-delay: calc(0.5s + var(--d));
  }
  :global(.is-visible) .note {
    opacity: 1;
  }
</style>
