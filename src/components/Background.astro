---
// Fixed backdrop = the drawing sheet itself: millimetre paper, a sheet border
// with zone ticks, a lamp, and an AutoCAD-style crosshair on desktop.
// The drawings that tell the story live inside each section, not here.
const ticks = Array.from({ length: 24 }, (_, i) => i);
---

<div class="bg" aria-hidden="true">
  <div class="paper"></div>
  <div class="lamp"></div>
  <div class="vignette"></div>

  <div class="frame">
    <div class="frame-ticks top">
      {ticks.map((i) => (
        <span>{i + 1}</span>
      ))}
    </div>
  </div>

  <!-- AutoCAD-style crosshair (desktop only, positioned by the client script) -->
  <div class="xhair">
    <span class="xh-h"></span>
    <span class="xh-v"></span>
    <span class="xh-box"></span>
    <span class="xh-coords"></span>
  </div>
</div>

<style>
  .bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: radial-gradient(120% 90% at 50% 0%, var(--bg) 45%, var(--bg-deep) 100%);
  }

  /* Millimetre paper: 8px minor, 40px (×5) medium, 200px (×25) major */
  .paper {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid-line-major) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line-major) 1px, transparent 1px),
      linear-gradient(var(--grid-line-mid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line-mid) 1px, transparent 1px),
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size:
      200px 200px,
      200px 200px,
      40px 40px,
      40px 40px,
      8px 8px,
      8px 8px;
    background-position: -1px -1px;
    mask-image: radial-gradient(ellipse 95% 85% at 50% 40%, #000 35%, transparent 95%);
  }

  .lamp {
    position: absolute;
    width: 60vmax;
    height: 60vmax;
    top: -28vmax;
    left: 50%;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(circle, var(--spotlight), transparent 65%);
  }

  /* Sheet border, like the frame of an engineering drawing */
  .frame {
    position: absolute;
    inset: 10px;
    border: 1px solid var(--ink-faint);
    display: none;
  }
  .frame::after {
    content: '';
    position: absolute;
    inset: 16px;
    border: 1.5px solid var(--ink-faint);
  }
  .frame-ticks {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 0;
    height: 16px;
    display: grid;
    grid-template-columns: repeat(24, 1fr);
  }
  .frame-ticks span {
    border-left: 1px solid var(--ink-faint);
    font-family: var(--font-mono);
    font-size: 8px;
    line-height: 16px;
    text-align: center;
    color: var(--ink);
  }
  @media (min-width: 1280px) {
    .frame {
      display: block;
    }
  }

  .vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 100% 100% at 50% 40%, transparent 60%, var(--bg-deep) 100%);
    opacity: 0.6;
  }

  .xhair {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  :global(.has-xhair) .xhair {
    opacity: 1;
  }
  .xh-h,
  .xh-v {
    position: absolute;
    background: var(--ink-faint);
  }
  .xh-h {
    left: 0;
    right: 0;
    height: 1px;
    top: var(--sy, -10px);
  }
  .xh-v {
    top: 0;
    bottom: 0;
    width: 1px;
    left: var(--sx, -10px);
  }
  .xh-box {
    position: absolute;
    width: 12px;
    height: 12px;
    left: var(--sx, -10px);
    top: var(--sy, -10px);
    translate: -50% -50%;
    border: 1px solid var(--ink);
  }
  .xh-coords {
    position: absolute;
    left: var(--sx, -10px);
    top: var(--sy, -10px);
    translate: 14px 12px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-accent);
    white-space: nowrap;
  }
  .xh-coords::after {
    content: var(--coords, '');
  }
</style>
