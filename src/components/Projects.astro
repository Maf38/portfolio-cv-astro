---
import SectionHeader from './SectionHeader.astro';
import Icon from './Icon.astro';
import { asset, inlineMd } from '../lib/utils';
import site from '../data/site.json';

const featured = site.projects.featured[0];
const others = site.projects.others;

type Link = {
  icon: string;
  iconSrc: string;
  href: string;
  ariaLabel: string;
  alt: string;
  title?: string;
};
---

<section id="projects" class="section" aria-labelledby="projects-title">
  <SectionHeader index={3} stage="deploy" title={site.ui.sectionHeadings.projects} id="projects" />

  {/* ---------------- Featured ---------------- */}
  <article class="card featured reveal" data-glow>
    <div class="featured-orbit" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>

    <div class="featured-body">
      <p class="tag">
        <Icon name="sparkles" size={14} /> featured
      </p>
      <h3 class="featured-title">
        <a href={featured.titleHref} target="_blank" rel="noopener noreferrer">
          {featured.name}
          <Icon name="arrowUpRight" size={18} class="ext" />
        </a>
      </h3>
      <p class="featured-desc">{featured.description}</p>

      <div class="terminal" role="note">
        <div class="term-bar" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
          <span>rule.ifttt</span>
        </div>
        <code>
          {featured.example
            .replace(/^Example:\s*/, '')
            .split(/(\bIF\b|\bAND\b|\bTHEN\b)/)
            .map((part) =>
              ['IF', 'AND', 'THEN'].includes(part) ? <span class="kw">{part}</span> : part,
            )}
        </code>
      </div>

      <p class="featured-context">{featured.context}</p>
    </div>

    <h4 class="sub-title">{featured.subProjectsTitle}</h4>
    <ul class="subs">
      {featured.subProjects.map((sp, i) => (
        <li class="sub reveal" style={`--delay:${i * 70}ms`}>
          <div class="sub-head">
            <span class="sub-name">
              {sp.private && <Icon name="lock" size={13} class="lock" />}
              {sp.name}
            </span>
            <span class="sub-links">
              {(sp.links as Link[]).map((l) => (
                <a
                  href={l.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={l.ariaLabel}
                  title={l.title ?? l.alt}
                >
                  <span class="logo-mask link-mask" style={`--src:url('${asset(l.iconSrc)}')`} />
                </a>
              ))}
            </span>
          </div>
          <p>{sp.description}</p>
          <ul class="chips mini">
            {sp.technologies.map((t) => (
              <li class="chip">{t}</li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </article>

  {/* ---------------- Others ---------------- */}
  <ul class="grid">
    {others.map((p, i) => (
      <li class="reveal" style={`--delay:${(i % 2) * 90}ms`}>
        <article class="card card-hover project" data-glow>
          <div class="project-top">
            <span class="folder" aria-hidden="true">
              <Icon name={p.private ? 'lock' : 'terminal'} size={20} />
            </span>
            <span class="project-links">
              {(p.links as Link[]).map((l) => (
                <a
                  href={l.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={l.ariaLabel}
                  title={l.title ?? l.alt}
                >
                  <span class="logo-mask link-mask" style={`--src:url('${asset(l.iconSrc)}')`} />
                </a>
              ))}
            </span>
          </div>

          <h3>
            <a href={p.titleHref} target="_blank" rel="noopener noreferrer" class="stretched">
              {p.name}
            </a>
          </h3>
          <div class="badges">
            {p.statusBadge && (
              <span class="badge wip">
                <span class="spinner" aria-hidden="true" />
                {p.statusBadge}
              </span>
            )}
            {p.private && <span class="badge priv">{site.ui.privateRepoTitle}</span>}
          </div>

          <p class="desc" set:html={inlineMd(p.description)} />

          <ul class="chips mini">
            {p.technologies.map((t) => (
              <li class="chip">{t}</li>
            ))}
          </ul>
        </article>
      </li>
    ))}
  </ul>
</section>

<style>
  /* ---------- featured ---------- */
  .featured {
    overflow: hidden;
    padding: 1.6rem;
    border-radius: 2rem;
    background:
      radial-gradient(
        120% 90% at 100% 0%,
        color-mix(in oklab, var(--secondary) 12%, transparent),
        transparent 55%
      ),
      radial-gradient(
        90% 80% at 0% 100%,
        color-mix(in oklab, var(--primary) 10%, transparent),
        transparent 60%
      ),
      color-mix(in oklab, var(--surface) 92%, transparent);
    box-shadow: var(--shadow-2);
  }
  .featured::after {
    opacity: 0.55;
  }
  @media (min-width: 768px) {
    .featured {
      padding: 2.6rem;
    }
  }
  .featured-orbit {
    position: absolute;
    right: -140px;
    top: -140px;
    width: 420px;
    height: 420px;
    pointer-events: none;
  }
  .featured-orbit span {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid var(--orbit-2);
  }
  .featured-orbit span:nth-child(2) {
    inset: 60px;
    border-style: dashed;
    animation: spin 50s linear infinite;
  }
  .featured-orbit span:nth-child(3) {
    inset: 120px;
    border-color: var(--orbit);
  }
  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }

  .featured-body {
    position: relative;
    max-width: 44rem;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--secondary);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--secondary) 12%, transparent);
  }
  .featured-title {
    margin-top: 0.9rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 3.4vw, 2.15rem);
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .featured-title a,
  h3 a {
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .featured-title a:hover,
  h3 a:hover {
    color: var(--primary);
  }
  .featured-title :global(.ext) {
    display: inline;
    vertical-align: middle;
    opacity: 0.5;
  }
  .featured-desc {
    margin-top: 0.9rem;
    color: var(--text-muted);
    font-size: 1.05rem;
  }
  .featured-context {
    margin-top: 1.1rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .terminal {
    margin-top: 1.3rem;
    border-radius: 1rem;
    overflow: hidden;
    background: #0a0f1c;
    border: 1px solid rgb(148 163 184 / 0.15);
    box-shadow: var(--shadow-2);
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.8rem;
    background: rgb(255 255 255 / 0.04);
    border-bottom: 1px solid rgb(148 163 184 / 0.12);
  }
  .term-bar i {
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 50%;
    background: #ff5f57;
  }
  .term-bar i:nth-child(2) {
    background: #febc2e;
  }
  .term-bar i:nth-child(3) {
    background: #28c840;
  }
  .term-bar span {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: #64748b;
  }
  .terminal code {
    display: block;
    padding: 1rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    line-height: 1.7;
    color: #cbd5e1;
    overflow-x: auto;
  }
  .terminal .kw {
    color: #c4b5fd;
    font-weight: 700;
  }

  .sub-title {
    position: relative;
    margin: 2.2rem 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-muted);
  }
  .subs {
    position: relative;
    display: grid;
    gap: 0.9rem;
    list-style: none;
    padding: 0;
  }
  @media (min-width: 720px) {
    .subs {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .subs {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .sub {
    padding: 1.1rem 1.15rem;
    border-radius: 1.15rem;
    background: color-mix(in oklab, var(--surface-2) 80%, transparent);
    border: 1px solid var(--outline);
    transition:
      border-color 0.3s ease,
      transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
      background-color 0.3s ease;
  }
  .sub:hover {
    border-color: color-mix(in oklab, var(--primary) 35%, transparent);
    background: var(--surface);
    transform: translateY(-3px);
  }
  .sub-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }
  .sub-name {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    font-weight: 600;
  }
  .sub-name :global(.lock) {
    color: var(--text-faint);
  }
  .sub p {
    margin-top: 0.6rem;
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .sub-links,
  .project-links {
    display: inline-flex;
    gap: 0.25rem;
  }
  .sub-links a,
  .project-links a {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.6rem;
    transition: background-color 0.25s ease;
  }
  .sub-links a:hover,
  .project-links a:hover {
    background: var(--surface-3);
  }
  .link-mask {
    width: 1.05rem;
    height: 1.05rem;
  }
  a:hover > .link-mask {
    background-color: var(--primary);
  }

  /* ---------- grid ---------- */
  .grid {
    margin-top: 1.5rem;
    display: grid;
    gap: 1.25rem;
    list-style: none;
    padding: 0;
  }
  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .grid > li {
    display: flex;
  }
  .project {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
  }
  .project-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .folder {
    width: 2.6rem;
    height: 2.6rem;
    display: grid;
    place-items: center;
    border-radius: 0.9rem;
    color: var(--primary);
    background: color-mix(in oklab, var(--primary) 12%, transparent);
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .project:hover .folder {
    transform: rotate(-8deg) scale(1.08);
  }
  .project h3 {
    margin-top: 1.1rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
    letter-spacing: -0.015em;
  }
  .stretched::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }
  .badges:empty {
    display: none;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.22rem 0.55rem;
    border-radius: 999px;
  }
  .badge.wip {
    color: #d97706;
    background: rgb(245 158 11 / 0.13);
  }
  :global([data-theme='dark']) .badge.wip {
    color: #fbbf24;
  }
  .badge.priv {
    color: var(--text-muted);
    background: var(--surface-2);
  }
  .spinner {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    border-right-color: transparent;
    animation: spin 0.9s linear infinite;
  }
  .project .desc {
    margin-top: 0.8rem;
    color: var(--text-muted);
    font-size: 0.93rem;
    flex: 1;
  }
  .project .desc :global(a) {
    position: relative;
    z-index: 2;
  }

  .chips {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
  }
  .chips.mini .chip {
    font-size: 0.66rem;
    padding: 0.32rem 0.55rem;
  }
</style>
