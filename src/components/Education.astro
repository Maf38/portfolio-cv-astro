---
import SectionHeader from './SectionHeader.astro';
import Icon from './Icon.astro';
import site from '../data/site.json';
---

<section id="education" class="section" aria-labelledby="education-title">
  <SectionHeader index={4} stage="learn" title={site.ui.sectionHeadings.education} id="education" />

  <ol class="edu">
    {site.education.map((e, i) => (
      <li class="reveal" style={`--delay:${(i % 3) * 80}ms`}>
        <article class="card card-hover edu-card" data-glow>
          <div class="edu-top">
            <span class={`year ${/^\d{4}$/.test(e.period) ? '' : 'long'}`}>{e.period}</span>
            <span class="cap" aria-hidden="true">
              <Icon name="graduation" size={18} />
            </span>
          </div>
          <h3>{e.degree}</h3>
          <p class="school">{e.displayedSubtitle.replace(/^·\s*/, '')}</p>
          <p class="desc">{e.description}</p>
        </article>
      </li>
    ))}
  </ol>
</section>

<style>
  .edu {
    display: grid;
    gap: 1.1rem;
    list-style: none;
    padding: 0;
  }
  @media (min-width: 700px) {
    .edu {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1050px) {
    .edu {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .edu > li {
    display: flex;
  }
  .edu-card {
    flex: 1;
    padding: 1.4rem;
  }
  .edu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .year {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.9rem;
    letter-spacing: -0.04em;
    line-height: 1;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .year.long {
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .cap {
    width: 2.3rem;
    height: 2.3rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--text-muted);
    border: 1px dashed var(--outline-strong);
    transition:
      color 0.3s ease,
      transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .edu-card:hover .cap {
    color: var(--primary);
    transform: rotate(180deg);
  }
  h3 {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.35;
  }
  .school {
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--primary);
  }
  .desc {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
</style>
