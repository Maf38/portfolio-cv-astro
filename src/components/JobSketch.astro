---
/**
 * A small technical figure for each job, drawn in the margin of its card.
 * Each one depicts what the job was actually about (see captions).
 */
interface Props {
  id: string;
  fig: number;
}
const { id, fig } = Astro.props;

const captions: Record<string, string> = {
  'exp-0': 'grant-call form, SIM platform',
  'exp-1': 'rack — 70+ applications',
  'exp-2': 'ETL data flow',
  'exp-3': 'data validation grid',
  'exp-4': 'SPC control chart',
  'exp-5': 'MES mobile interface',
  'exp-6': 'Exchange ↔ Azure daemon',
  'exp-7': '200 mm silicon wafer',
  'exp-8': 'glass syringe assembly',
  'exp-9': 'maintenance logbook',
};

// 200 mm wafer die grid (dies fully inside the circle)
const dies: { x: number; y: number }[] = [];
for (let i = -5; i <= 4; i++)
  for (let j = -5; j <= 4; j++) {
    const x = 80 + i * 9.5;
    const y = 58 + j * 9.5;
    const far = Math.max(
      Math.hypot(x - 80, y - 58),
      Math.hypot(x + 9.5 - 80, y + 9.5 - 58),
      Math.hypot(x - 80, y + 9.5 - 58),
      Math.hypot(x + 9.5 - 80, y - 58),
    );
    if (far < 45) dies.push({ x, y });
  }

// SPC chart data (deterministic)
const spc = [0, 6, -4, 8, 2, -7, 3, 11, -2, 5, -9, 1, 7, -3, 4];
const spcPath = spc.map((v, i) => `${i ? 'L' : 'M'}${18 + i * 9} ${58 - v * 2}`).join(' ');
---

<figure class="sketch" aria-hidden="true">
  <svg viewBox="0 0 160 116">
    {id === 'exp-0' && (
      <g>
        <path d="M44 8 H104 L118 22 V106 H44 Z M104 8 V22 H118" />
        <path d="M54 34 H108 M54 44 H96 M54 54 H108 M54 64 H88" class="thin" />
        <rect x="54" y="74" width="7" height="7" />
        <rect x="54" y="86" width="7" height="7" />
        <path d="M55.5 77.5 l2 2 l3.5 -4" class="accent" />
        <path d="M66 78 H96 M66 90 H90" class="thin" />
        <circle cx="104" cy="88" r="12" class="accent" />
        <text x="104" y="91" class="stamp">
          ANR
        </text>
      </g>
    )}
    {id === 'exp-1' && (
      <g>
        <rect x="48" y="6" width="64" height="104" rx="2" />
        {[0, 1, 2, 3, 4, 5, 6].map((k) => (
          <g>
            <rect x="54" y={12 + k * 13.5} width="52" height="10" />
            <circle
              cx="60"
              cy={17 + k * 13.5}
              r="1.6"
              class={k % 3 === 0 ? 'led accent-fill' : 'led'}
            />
            <path d={`M66 ${17 + k * 13.5} H100`} class="thin dash" />
          </g>
        ))}
        <path d="M40 6 V110 M36 6 H44 M36 110 H44" class="thin" />
        <text x="34" y="60" class="dim v">
          42U
        </text>
      </g>
    )}
    {id === 'exp-2' && (
      <g>
        {[18, 18 + 104].map((x) => (
          <g>
            <ellipse cx={x + 10} cy="40" rx="12" ry="4" />
            <path d={`M${x - 2} 40 V70 A12 4 0 0 0 ${x + 22} 70 V40`} />
          </g>
        ))}
        <path d="M60 36 H100 L88 56 V74 H72 V56 Z" />
        <path d="M34 56 H58 M102 56 H120" class="accent" marker-end="url(#sk-arrow)" />
        <text x="80" y="92" class="dim">
          ETL
        </text>
        <path d="M66 46 H94" class="thin" />
      </g>
    )}
    {id === 'exp-3' && (
      <g>
        <rect x="26" y="14" width="108" height="80" />
        {[1, 2, 3, 4].map((r) => (
          <path d={`M26 ${14 + r * 16} H134`} class="thin" />
        ))}
        <path d="M62 14 V94 M98 14 V94" class="thin" />
        {[1, 2, 3, 4].map((r) => (
          <path d={`M108 ${24 + r * 16 - 16 + 6} l3 3 l6 -7`} class={r === 3 ? 'warn' : 'accent'} />
        ))}
        <text x="80" y="108" class="dim">
          PL/SQL rules
        </text>
      </g>
    )}
    {id === 'exp-4' && (
      <g>
        <path d="M14 8 V100 H150" />
        <path d="M14 58 H150" class="thin" />
        <path d="M14 30 H150 M14 86 H150" class="thin dash warn-stroke" />
        <text x="152" y="32" class="lbl">
          UCL
        </text>
        <text x="152" y="88" class="lbl">
          LCL
        </text>
        <path d={spcPath} class="accent" />
        {spc.map((v, i) => (
          <circle cx={18 + i * 9} cy={58 - v * 2} r="1.8" class="pt" />
        ))}
      </g>
    )}
    {id === 'exp-5' && (
      <g>
        <rect x="56" y="6" width="48" height="96" rx="8" />
        <rect x="61" y="16" width="38" height="70" rx="2" class="thin" />
        <circle cx="80" cy="94" r="3" class="thin" />
        <path d="M66 28 H94 M66 36 H86" class="thin" />
        <circle cx="80" cy="60" r="12" class="accent" />
        <path d="M80 48 V44 M80 72 V76 M68 60 H64 M92 60 H96" class="accent" />
        <circle cx="80" cy="60" r="4" />
      </g>
    )}
    {id === 'exp-6' && (
      <g>
        <rect x="16" y="40" width="54" height="36" rx="2" />
        <path d="M16 40 L43 62 L70 40" />
        <path
          d="M110 76 H140 A14 14 0 0 0 138 48 A20 20 0 0 0 100 50 A13 13 0 0 0 110 76 Z"
          class="accent"
        />
        <path d="M74 52 H98 M98 64 H74" class="thin" marker-end="url(#sk-arrow)" />
        <text x="122" y="96" class="dim">
          Azure
        </text>
        <text x="43" y="96" class="dim">
          Exchange
        </text>
      </g>
    )}
    {id === 'exp-7' && (
      <g>
        <path d="M80 13 A45 45 0 1 1 79.9 13 Z M74 102.5 A45 45 0 0 0 86 102.5" />
        {dies.map((d) => (
          <rect x={d.x} y={d.y} width="9.5" height="9.5" class="die" />
        ))}
        <path d="M30 58 H130" class="thin dash" />
        <path
          d="M33 112 H127"
          class="thin"
          marker-start="url(#sk-arrow)"
          marker-end="url(#sk-arrow)"
        />
        <text x="80" y="110" class="dim">
          Ø 200
        </text>
      </g>
    )}
    {id === 'exp-8' && (
      <g>
        <rect x="34" y="46" width="70" height="22" rx="2" />
        <path d="M104 52 H114 V62 H104 M114 57 H150" />
        <path d="M8 57 H34 M8 48 V66 M34 50 V64" />
        <path d="M40 46 V68 M52 46 V54 M64 46 V54 M76 46 V54 M88 46 V54" class="thin" />
        <rect x="22" y="40" width="4" height="34" class="accent" />
        <path
          d="M34 84 H104"
          class="thin"
          marker-start="url(#sk-arrow)"
          marker-end="url(#sk-arrow)"
        />
        <text x="69" y="80" class="dim">
          glass barrel
        </text>
      </g>
    )}
    {id === 'exp-9' && (
      <g>
        <rect x="44" y="10" width="72" height="96" rx="3" />
        {[0, 1, 2, 3, 4, 5].map((k) => (
          <circle cx="44" cy={20 + k * 16} r="3.5" />
        ))}
        <path d="M56 28 H106 M56 40 H100 M56 52 H106" class="thin" />
        <text x="80" y="80" class="dim">
          {'Sub Macro()'}
        </text>
        <path d="M56 88 H96" class="thin accent" />
      </g>
    )}
  </svg>
  <figcaption>
    fig. {fig} — {captions[id] ?? ''}
  </figcaption>
</figure>

<style>
  .sketch {
    margin: 0;
    width: 150px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    opacity: 0.8;
    transition: opacity 0.4s ease;
  }
  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  svg :global(path),
  svg :global(rect),
  svg :global(circle),
  svg :global(ellipse) {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.1;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  svg :global(.thin) {
    stroke: var(--ink-faint);
  }
  svg :global(.dash) {
    stroke-dasharray: 4 3;
  }
  svg :global(.accent) {
    stroke: var(--ink-accent);
    stroke-width: 1.4;
  }
  svg :global(.warn),
  svg :global(.warn-stroke) {
    stroke: #c0502a;
  }
  svg :global(.accent-fill),
  svg :global(.pt) {
    fill: var(--ink-accent);
    stroke: none;
  }
  svg :global(.die) {
    stroke: var(--ink-faint);
    stroke-width: 0.6;
  }
  svg :global(text) {
    font-family: var(--font-mono);
    font-size: 8px;
    fill: var(--ink);
    text-anchor: middle;
    stroke: none;
  }
  svg :global(.v) {
    writing-mode: vertical-rl;
  }
  svg :global(.lbl) {
    text-anchor: start;
    font-size: 6.5px;
  }
  svg :global(.stamp) {
    fill: var(--ink-accent);
    font-weight: 600;
    font-size: 7px;
  }
  figcaption {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--text-faint);
    text-align: center;
    line-height: 1.3;
  }
</style>
