---
interface Props {
  index: number;
  stage: string;
  title: string;
  id: string;
}
const { index, stage, title, id } = Astro.props;
---

<header class="sh reveal">
  <p class="eyebrow">
    <span class="dot"></span>
    <span class="num">{String(index).padStart(2, '0')}</span>
    <span>/</span>
    <span>stage: {stage}</span>
  </p>
  <h2 id={`${id}-title`}>{title}</h2>
  <span class="rule"></span>
</header>

<style>
  .sh {
    margin-bottom: 2.75rem;
  }
  h2 {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.1rem, 5vw, 3.2rem);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .rule {
    display: block;
    margin-top: 1.1rem;
    width: 4.5rem;
    height: 3px;
    border-radius: 3px;
    background: var(--grad);
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.3s;
  }
  :global(.is-visible) .rule {
    transform: scaleX(1);
  }
</style>
