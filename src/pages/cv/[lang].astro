---
/**
 * Two-page A4 résumé — "Atelier" edition.
 * One tone (warm paper, dark ink, a single brass accent), editorial grid:
 * a narrow left column for dates/labels, content on the right. No boxes,
 * no chips. Rendered to PDF at build time by scripts/generate-cv.mjs.
 */
import '@fontsource-variable/big-shoulders-display';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import QRCode from 'qrcode';
import { CV, type Lang, type Mission } from '../../data/cv-modern';
import { asset } from '../../lib/utils';
import { logoBox } from '../../lib/logos';

export function getStaticPaths() {
  return [{ params: { lang: 'fr' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const c = CV[lang];
const t = c.labels;
const NAME = ['Mafal', 'Gai'];

const qr = await QRCode.toString('https://mafalgai.com', {
  type: 'svg',
  margin: 0,
  errorCorrectionLevel: 'M',
  color: { dark: '#261c12', light: '#00000000' },
});

const logo = (src: string, base = 1.1) => {
  const b = logoBox(src, base);
  return `--src:url('${asset(src)}'); width:${b.w}; height:${b.h}`;
};

// Missions on sheet 1; the rest continue on sheet 2 under the same employer.
const PAGE1_MISSIONS = 4;
let seen = 0;
const split = c.employers.map((e) => {
  const first = e.missions.slice(0, Math.max(0, PAGE1_MISSIONS - seen));
  seen += e.missions.length;
  return { ...e, first, rest: e.missions.slice(first.length) };
});
const page1 = split
  .filter((e) => e.first.length)
  .map((e) => ({ ...e, missions: e.first, cont: false }));
const page2 = split
  .filter((e) => e.rest.length)
  .map((e) => ({ ...e, missions: e.rest, cont: true }));

// Career strip (mm-based SVG units: 1 unit = 1 year)
const Y0 = 2000;
const Y1 = 2027;
const stripX = (y: number) => ((y - Y0) / (Y1 - Y0)) * 1000;

const contacts = [c.location, c.email, c.phone, c.license];
const stackLabel = 'Stack';
type M = Mission;
const missionKey = (m: M) => m.client + m.period;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>CV — Mafal Gai — {c.title}</title>
  </head>
  <body>
    <!-- ======================= SHEET 1 ======================= -->
    <article class="sheet">
      <header class="head">
        <div class="photo">
          <img src={asset('/assets/images/cv/photo-cv.png')} alt="" />
        </div>
        <div class="id">
          <h1>
            {NAME[0]} <span>{NAME[1]}</span>
          </h1>
          <p class="role">{c.title}</p>
        </div>
        <a class="qr" href="https://mafalgai.com" aria-label="mafalgai.com">
          <span class="qr-code" set:html={qr} />
          <span class="qr-url">mafalgai.com</span>
        </a>
      </header>

      <p class="pitch">{c.pitch}</p>

      <ul class="contacts">
        {contacts.map((x) => (
          <li>{x}</li>
        ))}
        {c.links
          .filter((l) => l.icon !== 'globe')
          .map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
      </ul>

      <section class="figures">
        {c.stats.map((s) => (
          <div class="fig">
            <span class="v">{s.value}</span>
            <span class="l">{s.label}</span>
          </div>
        ))}
      </section>

      <section class="row strip-row">
        <p class="label">{t.career}</p>
        <div class="strip">
          <svg viewBox="0 0 1000 40" preserveAspectRatio="none" aria-hidden="true">
            <line x1="0" x2="1000" y1="20" y2="20" class="axis"></line>
            {c.career.map((s) => (
              <rect
                x={stripX(s.from)}
                y="16"
                width={Math.max(stripX(s.to) - stripX(s.from), 6)}
                height="8"
                class={`seg ${s.track}`}
              />
            ))}
          </svg>
          <div class="strip-labels">
            {c.career
              .filter((s) => s.label !== 'Cerberis')
              .map((s) => (
                <span
                  class={`sl ${s.track}`}
                  style={`left:${(stripX((s.from + s.to) / 2) / 10).toFixed(2)}%`}
                >
                  {s.label}
                </span>
              ))}
          </div>
          <div class="strip-years">
            {[2000, 2005, 2010, 2015, 2020, 2025].map((y) => (
              <span style={`left:${stripX(y) / 10}%`}>{y}</span>
            ))}
          </div>
        </div>
      </section>

      <h2 class="sec">{t.experience}</h2>
      {page1.map((e) => (
        <section class="employer">
          <div class="row emp">
            <div class="label emp-left">
              {e.logo && (
                <span class="mask" style={logo(e.logo, 1.2)} role="img" aria-label={e.name} />
              )}
            </div>
            <p class="emp-line">
              {!e.logoIsName && <b>{e.name}</b>}
              <span>{e.kind}</span>
              <span class="sep">·</span>
              <span>{e.period}</span>
            </p>
          </div>
          {e.missions.map((m) => (
            <div class="row mission" data-k={missionKey(m)}>
              <p class="label when">
                {m.period}
                {m.current && <span class="now">{t.current}</span>}
              </p>
              <div>
                <h3>
                  {m.role}
                  <span class="client"> — {m.client}</span>
                </h3>
                <ul class="bullets">
                  {m.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
                <p class="stack">
                  <span>{stackLabel}</span> {m.tags.join(', ')}
                </p>
              </div>
            </div>
          ))}
        </section>
      ))}

      <footer class="foot">
        <span>Mafal Gai — {c.title}</span>
        <span>1 / 2</span>
      </footer>
    </article>

    <!-- ======================= SHEET 2 ======================= -->
    <article class="sheet">
      {page2.map((e) => (
        <section class="employer">
          <div class="row emp">
            <div class="label emp-left">
              {e.logo && (
                <span class="mask" style={logo(e.logo, 1.2)} role="img" aria-label={e.name} />
              )}
            </div>
            <p class="emp-line">
              {!e.logoIsName && <b>{e.name}</b>}
              <span>{e.kind}</span>
              <span class="sep">·</span>
              <span>{t.continued}</span>
            </p>
          </div>
          {e.missions.map((m) => (
            <div class="row mission">
              <p class="label when">{m.period}</p>
              <div>
                <h3>
                  {m.role}
                  <span class="client"> — {m.client}</span>
                </h3>
                <ul class="bullets">
                  {m.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
                <p class="stack">
                  <span>{stackLabel}</span> {m.tags.join(', ')}
                </p>
              </div>
            </div>
          ))}
        </section>
      ))}

      <section class="employer">
        <div class="row mission">
          <p class="label when">{c.internship.period}</p>
          <div>
            <h3>
              {c.internship.role}
              <span class="client"> — {c.internship.company}</span>
            </h3>
            <ul class="bullets">
              {c.internship.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
            <p class="stack">
              <span>{stackLabel}</span> {c.internship.tags.join(', ')}
            </p>
          </div>
        </div>
      </section>

      <h2 class="sec">{t.industry}</h2>
      {c.industry.map((i) => (
        <div class="row mission compact">
          <p class="label when">{i.period}</p>
          <div>
            <h3>
              {i.role}
              <span class="client"> — {i.company}</span>
            </h3>
            <p class="para">{i.text}</p>
          </div>
        </div>
      ))}

      <h2 class="sec">{t.projects}</h2>
      <div class="projects">
        {c.projects.map((p) => (
          <div class="project">
            <h3>{p.name}</h3>
            <p class="para">{p.text}</p>
            <p class="stack">{p.tags.slice(0, 5).join(', ')}</p>
          </div>
        ))}
      </div>

      <div class="cols3">
        <section>
          <h2 class="sec">{t.skills}</h2>
          <dl class="skills">
            {c.skills.map((g) => (
              <>
                <dt>{g.group}</dt>
                <dd>{g.items.join(', ')}</dd>
              </>
            ))}
          </dl>
        </section>
        <section>
          <h2 class="sec">{t.education}</h2>
          <ul class="edu">
            {c.education.map((e) => (
              <li>
                <span class="y">{e.year}</span>
                <span>
                  <b>{e.title}</b>
                  {e.note && <em> — {e.note}</em>}
                  <br />
                  <span class="muted">{e.school}</span>
                </span>
              </li>
            ))}
          </ul>
          <p class="early">{c.earlyEducation}</p>
          <p class="learn-line">
            <span>{t.learning}</span>
            {c.learning.items.join(', ')}
          </p>
        </section>
        <section>
          <h2 class="sec">{t.languages}</h2>
          <ul class="plain">
            {c.languages.map((l) => (
              <li>
                <b>{l.name}</b> <span class="muted">{l.level}</span>
              </li>
            ))}
          </ul>
          <h2 class="sec small">{t.interests}</h2>
          <ul class="plain">
            {c.interests.map((i) => (
              <li>{i}</li>
            ))}
          </ul>
        </section>
      </div>

      <footer class="foot">
        <span>Mafal Gai — {c.title}</span>
        <span>2 / 2</span>
      </footer>
    </article>
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 0;
  }
  :root {
    --paper: #fbf8f2;
    --ink: #221a11;
    --ink-2: #4a3f31;
    --muted: #7c6e5b;
    --rule: #e3d9c8;
    --brass: #9a6a22;
    --brass-l: #c9994a;
    --copper: #a14a22;
    --left: 31mm;
    --gap: 6mm;
    --pad-x: 16mm;
  }
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  html {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  body {
    font-family: 'Inter Variable', system-ui, sans-serif;
    font-size: 8.4pt;
    line-height: 1.45;
    color: var(--ink-2);
  }
  @media screen {
    body {
      background: #d9d2c5;
      padding: 24px 0;
    }
    .sheet {
      margin: 0 auto 24px;
      box-shadow: 0 10px 40px rgb(40 25 10 / 0.25);
    }
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  ul {
    list-style: none;
  }

  .sheet {
    position: relative;
    width: 210mm;
    height: 297mm;
    overflow: hidden;
    background: var(--paper);
    padding: 12mm var(--pad-x) 13mm;
    break-after: page;
  }
  .sheet:last-child {
    break-after: auto;
  }
  .mask {
    display: inline-block;
    background-color: var(--ink);
    -webkit-mask: var(--src) left center / contain no-repeat;
    mask: var(--src) left center / contain no-repeat;
  }

  /* ---------- editorial grid ---------- */
  .row {
    display: grid;
    grid-template-columns: var(--left) 1fr;
    column-gap: var(--gap);
  }
  .label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 7pt;
    line-height: 1.5;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  /* ---------- header ---------- */
  .head {
    display: grid;
    grid-template-columns: var(--left) 1fr auto;
    column-gap: var(--gap);
    align-items: center;
  }
  .photo {
    width: 25mm;
    height: 25mm;
    border-radius: 50%;
    padding: 0.7mm;
    background: linear-gradient(150deg, #f1d38f, var(--brass) 55%, #6e4a16);
  }
  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 0.8mm solid var(--paper);
  }
  h1 {
    font-family: 'Big Shoulders Display Variable', sans-serif;
    font-weight: 800;
    font-size: 37pt;
    line-height: 0.9;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    color: var(--ink);
  }
  h1 span {
    color: var(--brass);
  }
  .role {
    margin-top: 2mm;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10pt;
    font-weight: 500;
    color: var(--ink);
  }
  .qr {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.4mm;
  }
  .qr-code {
    display: block;
    width: 19mm;
    height: 19mm;
  }
  .qr-code svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .qr-url {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 6.6pt;
    color: var(--muted);
  }

  .pitch {
    margin: 4mm 0 0 calc(var(--left) + var(--gap));
    font-size: 9pt;
    line-height: 1.55;
    color: var(--ink);
  }

  .contacts {
    margin: 3mm 0 0 calc(var(--left) + var(--gap));
    display: flex;
    flex-wrap: wrap;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 6.7pt;
    color: var(--ink-2);
  }
  .contacts li + li::before {
    content: '/';
    margin: 0 1.6mm;
    color: var(--brass-l);
  }

  /* ---------- key figures: typography only ---------- */
  .figures {
    margin-top: 4.5mm;
    padding: 2.6mm 0;
    border-top: 0.6pt solid var(--ink);
    border-bottom: 0.4pt solid var(--rule);
    display: grid;
    grid-template-columns: var(--left) repeat(4, 1fr);
    column-gap: var(--gap);
  }
  .figures::before {
    content: '';
  }
  .fig {
    display: flex;
    flex-direction: column;
    gap: 0.6mm;
  }
  .fig .v {
    font-family: 'Big Shoulders Display Variable', sans-serif;
    font-weight: 700;
    font-size: 18pt;
    line-height: 1;
    color: var(--ink);
  }
  .fig .l {
    font-size: 7.2pt;
    line-height: 1.3;
    color: var(--muted);
  }

  /* ---------- career strip ---------- */
  .strip-row {
    margin-top: 3.5mm;
    align-items: start;
  }
  .strip {
    position: relative;
    height: 10.5mm;
  }
  .strip svg {
    position: absolute;
    left: 0;
    right: 0;
    top: 3.6mm;
    width: 100%;
    height: 3mm;
  }
  .strip .axis {
    stroke: var(--rule);
    stroke-width: 2;
  }
  .seg.industry {
    fill: #b9ab94;
  }
  .seg.transition {
    fill: var(--copper);
  }
  .seg.software {
    fill: var(--brass);
  }
  .strip-labels span,
  .strip-years span {
    position: absolute;
    translate: -50% 0;
    white-space: nowrap;
  }
  .strip-labels span {
    top: 0;
    font-size: 6.6pt;
    font-weight: 600;
    color: var(--ink-2);
  }
  .strip-labels .transition {
    color: var(--copper);
  }
  .strip-years span {
    top: 7.6mm;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 6pt;
    color: var(--muted);
  }

  /* ---------- sections ---------- */
  .sec {
    margin: 4mm 0 1.8mm;
    display: grid;
    grid-template-columns: var(--left) 1fr;
    column-gap: var(--gap);
    align-items: center;
    font-family: 'Big Shoulders Display Variable', sans-serif;
    font-weight: 800;
    font-size: 15pt;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .sec::before {
    content: '';
    height: 0.6pt;
    background: var(--ink);
    order: 0;
  }
  .sec.small {
    margin: 4.5mm 0 1.2mm;
    font-size: 11pt;
    display: block;
  }
  .sec.small::before {
    display: none;
  }
  .sheet > .employer:first-child {
    margin-top: 0;
  }

  .employer + .employer {
    margin-top: 2.5mm;
  }
  .emp {
    align-items: center;
    padding-bottom: 2mm;
  }
  .emp-left {
    display: flex;
    align-items: center;
    min-height: 6mm;
  }
  .emp-line {
    display: flex;
    gap: 1.6mm;
    align-items: baseline;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 7.3pt;
    color: var(--muted);
  }
  .emp-line b {
    font-family: 'Inter Variable', sans-serif;
    font-size: 9.5pt;
    color: var(--ink);
  }
  .sep {
    color: var(--brass-l);
  }

  .mission {
    padding: 1.5mm 0 1.9mm;
  }
  .mission + .mission {
    border-top: 0.4pt solid var(--rule);
  }
  .mission.compact {
    padding: 1.6mm 0;
  }
  .when {
    padding-top: 0.6mm;
  }
  .now {
    display: block;
    margin-top: 0.8mm;
    color: var(--brass);
    font-weight: 500;
  }
  .now::before {
    content: '● ';
    font-size: 6pt;
  }
  h3 {
    font-size: 9.6pt;
    font-weight: 650;
    color: var(--ink);
    line-height: 1.35;
  }
  .client {
    font-weight: 400;
    color: var(--muted);
  }
  .bullets {
    margin-top: 1mm;
  }
  .bullets li {
    position: relative;
    padding-left: 3.4mm;
  }
  .bullets li + li {
    margin-top: 0.5mm;
  }
  .bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.68em;
    width: 1.6mm;
    height: 0.6pt;
    background: var(--brass);
  }
  .stack {
    margin-top: 1.2mm;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 6.8pt;
    color: var(--muted);
  }
  .stack span {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--brass);
    margin-right: 1mm;
  }
  .para {
    margin-top: 0.6mm;
  }

  .projects {
    margin-left: calc(var(--left) + var(--gap));
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.4mm 7mm;
  }
  .project h3 {
    font-family: 'Big Shoulders Display Variable', sans-serif;
    font-weight: 700;
    font-size: 11.5pt;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .project .para {
    font-size: 7.8pt;
  }
  .learn-line {
    margin-top: 2mm;
    font-size: 7.8pt;
    color: var(--ink);
  }
  .learn-line span {
    display: block;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 6.6pt;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brass);
  }

  .cols3 {
    display: grid;
    grid-template-columns: 1.45fr 1.15fr 0.7fr;
    column-gap: 6mm;
  }
  .cols3 .sec {
    display: block;
  }
  .cols3 .sec::before {
    display: none;
  }
  .plain li + li {
    margin-top: 0.6mm;
  }
  .plain b {
    color: var(--ink);
    font-weight: 600;
  }
  .cols3 > section > .sec:first-child {
    border-top: 0.6pt solid var(--ink);
    padding-top: 2mm;
  }
  .skills {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 3mm;
  }
  .skills dt {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 6.6pt;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-top: 1mm;
  }
  .skills dt:first-child {
    margin-top: 0;
  }
  .skills dt.learn {
    color: var(--brass);
  }
  .skills dd {
    color: var(--ink);
    line-height: 1.35;
  }
  .edu li {
    display: grid;
    grid-template-columns: 10mm 1fr;
    gap: 2mm;
  }
  .edu li + li {
    margin-top: 1.6mm;
  }
  .edu .y {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 7pt;
    color: var(--brass);
    padding-top: 0.3mm;
  }
  .edu b {
    color: var(--ink);
    font-weight: 600;
  }
  .edu em {
    font-style: normal;
    color: var(--brass);
  }
  .muted {
    color: var(--muted);
  }
  .early {
    margin-top: 1.8mm;
    font-size: 7.4pt;
    color: var(--muted);
  }

  .foot {
    position: absolute;
    left: var(--pad-x);
    right: var(--pad-x);
    bottom: 5.5mm;
    display: flex;
    justify-content: space-between;
    padding-top: 2mm;
    border-top: 0.4pt solid var(--rule);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 6.6pt;
    color: var(--muted);
  }
</style>
