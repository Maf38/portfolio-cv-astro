---
/**
 * Two-page A4 résumé, "Pipeline" design.
 * Rendered to PDF at build time by scripts/generate-cv.mjs (Chromium page.pdf):
 * real vector text, selectable and ATS-readable.
 */
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import QRCode from 'qrcode';
import { CV, type Lang } from '../../data/cv-modern';
import { asset } from '../../lib/utils';
import { lemniscatePath } from '../../lib/loop';
import { logoBox } from '../../lib/logos';

export function getStaticPaths() {
  return [{ params: { lang: 'fr' } }, { params: { lang: 'en' } }];
}

const lang = Astro.params.lang as Lang;
const c = CV[lang];
const t = c.labels;
const NAME = 'Mafal Gai';

const qr = await QRCode.toString('https://mafalgai.com', {
  type: 'svg',
  margin: 0,
  errorCorrectionLevel: 'M',
  color: { dark: '#0a1222', light: '#ffffff' },
});

const logo = (src: string, base = 1.25) => {
  const b = logoBox(src, base);
  return `--src:url('${asset(src)}'); width:${b.w}; height:${b.h}`;
};

const icons: Record<string, string> = {
  mail: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  phone:
    '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
  pin: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  car: '<path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/>',
  globe:
    '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
  github:
    '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  linkedin:
    '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
};

const contacts = [
  { icon: 'pin', text: c.location },
  { icon: 'mail', text: c.email, href: `mailto:${c.email}` },
  { icon: 'phone', text: c.phone },
  { icon: 'car', text: c.license },
];

// ---- Career strip geometry (SVG units) ----
const Y0 = 2000;
const Y1 = 2027;
const W = 1000;
const X = (y: number) => 14 + ((y - Y0) / (Y1 - Y0)) * (W - 28);
const ticks = [2000, 2005, 2010, 2015, 2020, 2025];
const nowYear = 2026.8;

// Missions shown on sheet 1; the rest continue on sheet 2 under the same employer.
const PAGE1_MISSIONS = 3;
let seen = 0;
const split = c.employers.map((e) => {
  const first = e.missions.slice(0, Math.max(0, PAGE1_MISSIONS - seen));
  seen += e.missions.length;
  return { ...e, first, rest: e.missions.slice(first.length) };
});
const page1 = split
  .filter((e) => e.first.length)
  .map((e) => ({ ...e, missions: e.first, cont: false }));
const page2 = split
  .filter((e) => e.rest.length)
  .map((e) => ({ ...e, missions: e.rest, cont: true }));

const loop = lemniscatePath(120, 1.2, 200);
const loopSmall = lemniscatePath(14, 1.1, 100);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>CV — {NAME} — {c.title}</title>
  </head>
  <body>
    <!-- ======================= SHEET 1 ======================= -->
    <article class="sheet">
      <header class="hero">
        <svg class="hero-orbits" viewBox="-500 -260 1000 520" aria-hidden="true">
          <ellipse rx="460" ry="150" transform="rotate(-14)"></ellipse>
          <ellipse rx="340" ry="110" transform="rotate(-14)" class="d"></ellipse>
          <ellipse rx="220" ry="70" transform="rotate(-14)"></ellipse>
          <circle cx="300" cy="-150" r="4"></circle>
          <circle cx="-210" cy="104" r="3"></circle>
        </svg>
        <svg class="hero-loop" viewBox="-160 -90 320 180" aria-hidden="true">
          <path d={loop}></path>
        </svg>

        <div class="hero-grid">
          <div class="photo">
            <img src={asset('/assets/images/cv/photo-cv.png')} alt="" />
          </div>

          <div class="id">
            <p class="status">
              <span class="dot"></span>
              {lang === 'fr' ? 'Ouvert aux opportunités' : 'Open to opportunities'}
            </p>
            <h1>{NAME}</h1>
            <p class="role">{c.title}</p>
            <p class="pitch">{c.pitch}</p>
          </div>

          <a class="qr" href="https://mafalgai.com">
            <span class="qr-code" set:html={qr} />
            <span class="qr-label">{t.scan}</span>
          </a>
        </div>

        <div class="hero-meta">
          <ul class="contacts">
            {contacts.map((x) => (
              <li>
                <svg viewBox="0 0 24 24" set:html={icons[x.icon]} />
                {x.href ? <a href={x.href}>{x.text}</a> : <span>{x.text}</span>}
              </li>
            ))}
          </ul>
          <ul class="links">
            {c.links.map((l) => (
              <li>
                <svg viewBox="0 0 24 24" set:html={icons[l.icon]} />
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      </header>

      <section class="stats">
        {c.stats.map((s) => (
          <div class="stat">
            <span class="v">{s.value}</span>
            <span class="l">{s.label}</span>
          </div>
        ))}
      </section>

      <section class="career">
        <div class="career-head">
          <h2 class="mini">{t.career}</h2>
          <ul class="legend">
            <li>
              <i class="industry"></i>
              {t.industryTrack}
            </li>
            <li>
              <i class="transition"></i>
              {t.transitionTrack}
            </li>
            <li>
              <i class="software"></i>
              {t.softwareTrack}
            </li>
          </ul>
        </div>
        <svg viewBox="0 0 1000 92" class="strip" aria-hidden="true">
          <defs>
            <linearGradient id="sw" x1="0" x2="1" y1="0" y2="0">
              <stop offset="0" stop-color="#0e8fa8"></stop>
              <stop offset="1" stop-color="#0f9f6e"></stop>
            </linearGradient>
          </defs>
          <line x1={X(Y0)} x2={X(Y1)} y1="48" y2="48" class="axis"></line>
          {ticks.map((y) => (
            <g>
              <line x1={X(y)} x2={X(y)} y1="56" y2="62" class="tick" />
              <text x={X(y)} y="78" class="year">
                {y}
              </text>
            </g>
          ))}
          <line x1={X(nowYear)} x2={X(nowYear)} y1="56" y2="62" class="tick" />
          <text x={X(nowYear)} y="78" class="year now">
            {t.now}
          </text>

          {c.career.map((s) => {
            const x = X(s.from);
            const w = Math.max(X(s.to) - x, 7);
            const wide = w > 200;
            const label =
              s.label === 'ST Microelectronics'
                ? `${s.label} · 13 ${lang === 'fr' ? 'ans' : 'yrs'}`
                : s.label;
            return (
              <g class={`seg ${s.track}`}>
                <rect x={x} y="41" width={w} height="14" rx="7" />
                {wide ? (
                  <text x={x + w / 2} y="51.5" class="in">
                    {label}
                  </text>
                ) : s.label === 'Cerberis' ? null : (
                  <text
                    x={x + w / 2}
                    y={s.track === 'transition' ? 30 : 30}
                    class={`out ${s.track}`}
                  >
                    {label}
                  </text>
                )}
              </g>
            );
          })}
        </svg>
      </section>

      <div class="cols">
        <main class="main">
          <h2 class="sec">
            <span class="num">01</span>
            {t.experience}
          </h2>

          {page1.map((e) => (
            <section class="employer">
              <header class="emp-head">
                {e.logo && (
                  <span
                    class="mask emp-logo"
                    style={logo(e.logo, 1.5)}
                    role="img"
                    aria-label={e.name}
                  />
                )}
                {!e.logoIsName && <span class="emp-name">{e.name}</span>}
                <span class="emp-kind">{e.cont ? t.continued : e.kind}</span>
                <span class="emp-period">{e.period}</span>
              </header>
              <ol class="missions">
                {e.missions.map((m) => (
                  <li class={m.current ? 'current' : ''}>
                    <div class="m-top">
                      <div class="m-client">
                        {m.logos.map((l) => (
                          <span class="mask m-logo" style={logo(l, 0.95)} aria-hidden="true" />
                        ))}
                        <span>{m.client}</span>
                      </div>
                      <span class="m-period">
                        {m.current && <b class="live">{t.current}</b>}
                        {m.period}
                      </span>
                    </div>
                    <h3>{m.role}</h3>
                    <ul class="bullets">
                      {m.bullets.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                    <ul class="tags">
                      {m.tags.map((tg) => (
                        <li>{tg}</li>
                      ))}
                    </ul>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </main>

        <aside class="side">
          <h2 class="side-h">{t.skills}</h2>
          {c.skills.map((g) => (
            <div class="sk">
              <p class="sk-g">{g.group}</p>
              <ul class="sk-i">
                {g.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </div>
          ))}
        </aside>
      </div>

      <footer class="foot">
        <svg viewBox="-17 -9 34 18" aria-hidden="true">
          <path d={loopSmall}></path>
        </svg>
        <span>
          {NAME} · {c.title}
        </span>
        <span class="pg">1 / 2</span>
      </footer>
    </article>

    <!-- ======================= SHEET 2 ======================= -->
    <article class="sheet">
      <header class="strip-head">
        <svg viewBox="-17 -9 34 18" aria-hidden="true">
          <path d={loopSmall}></path>
        </svg>
        <span class="sh-name">{NAME}</span>
        <span class="sh-role">{c.title}</span>
        <span class="sh-mail">{c.email}</span>
      </header>

      <div class="cols">
        <main class="main">
          {page2.map((e) => (
            <section class="employer">
              <header class="emp-head">
                {e.logo && (
                  <span
                    class="mask emp-logo"
                    style={logo(e.logo, 1.5)}
                    role="img"
                    aria-label={e.name}
                  />
                )}
                {!e.logoIsName && <span class="emp-name">{e.name}</span>}
                <span class="emp-kind">{e.cont ? t.continued : e.kind}</span>
                <span class="emp-period">{e.period}</span>
              </header>
              <ol class="missions">
                {e.missions.map((m) => (
                  <li class={m.current ? 'current' : ''}>
                    <div class="m-top">
                      <div class="m-client">
                        {m.logos.map((l) => (
                          <span class="mask m-logo" style={logo(l, 0.95)} aria-hidden="true" />
                        ))}
                        <span>{m.client}</span>
                      </div>
                      <span class="m-period">
                        {m.current && <b class="live">{t.current}</b>}
                        {m.period}
                      </span>
                    </div>
                    <h3>{m.role}</h3>
                    <ul class="bullets">
                      {m.bullets.map((b) => (
                        <li>{b}</li>
                      ))}
                    </ul>
                    <ul class="tags">
                      {m.tags.map((tg) => (
                        <li>{tg}</li>
                      ))}
                    </ul>
                  </li>
                ))}
              </ol>
            </section>
          ))}
          <section class="employer">
            <header class="emp-head">
              <span class="emp-name">{c.internship.company}</span>
              <span class="emp-kind">{t.intern}</span>
              <span class="emp-period">{c.internship.period}</span>
            </header>
            <ol class="missions">
              <li>
                <h3>{c.internship.role}</h3>
                <ul class="bullets">
                  {c.internship.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
                <ul class="tags">
                  {c.internship.tags.map((tg) => (
                    <li>{tg}</li>
                  ))}
                </ul>
              </li>
            </ol>
          </section>

          <h2 class="sec">
            <span class="num">02</span>
            {t.industry}
          </h2>
          <ul class="industry">
            {c.industry.map((i) => (
              <li>
                <div class="ind-logo">
                  {i.logo && <span class="mask" style={logo(i.logo, 1.2)} aria-hidden="true" />}
                </div>
                <div>
                  <div class="m-top">
                    <span class="ind-co">{i.company}</span>
                    <span class="m-period">{i.period}</span>
                  </div>
                  <p class="ind-role">{i.role}</p>
                  <p class="ind-text">{i.text}</p>
                </div>
              </li>
            ))}
          </ul>

          <h2 class="sec">
            <span class="num">03</span>
            {t.projects}
            <span class="sec-note">{t.projectsNote}</span>
          </h2>
          <ul class="projects">
            {c.projects.map((p) => (
              <li>
                <h3>{p.name}</h3>
                <p>{p.text}</p>
                <ul class="tags">
                  {p.tags.slice(0, 5).map((tg) => (
                    <li>{tg}</li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </main>

        <aside class="side">
          <h2 class="side-h">{t.education}</h2>
          <ol class="edu">
            {c.education.map((e) => (
              <li>
                <span class="edu-year">{e.year}</span>
                <div>
                  <p class="edu-t">
                    {e.title}
                    {e.note && <b class="live">{e.note}</b>}
                  </p>
                  <p class="edu-s">{e.school}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="early">{c.earlyEducation}</p>
          <div class="learning">
            <p class="sk-g">
              <span class="pulse"></span>
              {t.learning}
            </p>
            <p class="learning-label">{c.learning.label}</p>
            <ul class="sk-i dashed">
              {c.learning.items.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>

          <h2 class="side-h">{t.languages}</h2>
          <ul class="langs">
            {c.languages.map((l) => (
              <li>
                <span>{l.name}</span>
                <span class="lvl">{l.level}</span>
              </li>
            ))}
          </ul>
          <h2 class="side-h">{t.interests}</h2>
          <ul class="interests">
            {c.interests.map((i) => (
              <li>{i}</li>
            ))}
          </ul>

          <a class="cta" href="https://mafalgai.com">
            <span class="cta-qr" set:html={qr} />
            <span class="cta-t">
              <b>mafalgai.com</b>
              <span>
                {lang === 'fr'
                  ? 'Portfolio, projets et CV en ligne'
                  : 'Portfolio, projects and online résumé'}
              </span>
            </span>
          </a>
        </aside>
      </div>

      <footer class="foot">
        <svg viewBox="-17 -9 34 18" aria-hidden="true">
          <path d={loopSmall}></path>
        </svg>
        <span>
          {NAME} · {c.title}
        </span>
        <span class="pg">2 / 2</span>
      </footer>
    </article>
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 0;
  }
  :root {
    --navy: #0a1222;
    --navy-2: #111c33;
    --ink: #0d1526;
    --muted: #4b5870;
    --faint: #8794aa;
    --line: #e2e8f0;
    --side: #f3f6fa;
    --primary: #0e8fa8;
    --primary-l: #4fd8eb;
    --secondary: #0f9f6e;
    --secondary-l: #3ddc97;
    --amber: #d98a06;
    --grad: linear-gradient(100deg, var(--primary), var(--secondary));
    --side-w: 58mm;
    --pad: 13mm;
  }
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }
  html {
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  body {
    font-family: 'Inter Variable', system-ui, sans-serif;
    font-size: 8.5pt;
    line-height: 1.45;
    color: var(--ink);
    font-feature-settings: 'ss01', 'cv11';
  }
  @media screen {
    body {
      background: #dfe5ee;
      padding: 24px 0;
    }
    .sheet {
      margin: 0 auto 24px;
      box-shadow: 0 12px 48px rgb(15 23 42 / 0.2);
    }
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  ul,
  ol {
    list-style: none;
  }

  .sheet {
    position: relative;
    width: 210mm;
    height: 297mm;
    overflow: hidden;
    background: #fff;
    display: flex;
    flex-direction: column;
    break-after: page;
  }
  .sheet:last-child {
    break-after: auto;
  }

  .mask {
    display: inline-block;
    flex-shrink: 0;
    background-color: currentColor;
    -webkit-mask: var(--src) center / contain no-repeat;
    mask: var(--src) center / contain no-repeat;
  }

  /* ================= HERO ================= */
  .hero {
    position: relative;
    overflow: hidden;
    color: #e7eef9;
    background:
      radial-gradient(70% 120% at 100% 0%, rgb(79 216 235 / 0.2), transparent 60%),
      radial-gradient(60% 120% at 0% 100%, rgb(61 220 151 / 0.12), transparent 60%),
      linear-gradient(160deg, var(--navy-2), var(--navy) 70%);
    padding: 9mm var(--pad) 13mm;
  }
  .hero-orbits {
    position: absolute;
    inset: -10mm -20mm auto auto;
    width: 150mm;
    opacity: 0.55;
  }
  .hero-orbits ellipse {
    fill: none;
    stroke: rgb(148 163 184 / 0.22);
    stroke-width: 1;
  }
  .hero-orbits .d {
    stroke-dasharray: 3 8;
    stroke: rgb(79 216 235 / 0.35);
  }
  .hero-orbits circle {
    fill: var(--primary-l);
  }
  .hero-loop {
    position: absolute;
    right: -18mm;
    bottom: -22mm;
    width: 95mm;
    opacity: 0.12;
  }
  .hero-loop path {
    fill: none;
    stroke: var(--secondary-l);
    stroke-width: 2.5;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 31mm 1fr 25mm;
    gap: 7mm;
    align-items: center;
  }
  .photo {
    width: 31mm;
    height: 31mm;
    border-radius: 50%;
    padding: 0.9mm;
    background: linear-gradient(140deg, var(--primary-l), var(--secondary-l));
    box-shadow: 0 0 0 2.2mm rgb(79 216 235 / 0.08);
  }
  .photo img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border-radius: 50%;
    border: 0.9mm solid var(--navy);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 1.6mm;
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 6.8pt;
    color: var(--secondary-l);
    border: 0.5pt solid rgb(61 220 151 / 0.35);
    background: rgb(61 220 151 / 0.08);
    padding: 0.7mm 2.2mm;
    border-radius: 99px;
  }
  .status .dot {
    width: 1.6mm;
    height: 1.6mm;
    border-radius: 50%;
    background: var(--secondary-l);
    box-shadow: 0 0 0 0.8mm rgb(61 220 151 / 0.2);
  }
  h1 {
    margin-top: 2.2mm;
    font-family: 'Space Grotesk Variable', sans-serif;
    font-weight: 700;
    font-size: 30pt;
    line-height: 1;
    letter-spacing: -0.035em;
    color: #fff;
  }
  .role {
    margin-top: 1.8mm;
    font-family: 'JetBrains Mono Variable', monospace;
    font-weight: 500;
    font-size: 10pt;
    color: var(--primary-l);
  }
  .role::before {
    content: '> ';
    color: var(--secondary-l);
  }
  .pitch {
    margin-top: 2.6mm;
    font-size: 8.6pt;
    line-height: 1.5;
    color: #b6c3d8;
    max-width: 112mm;
  }
  .qr {
    justify-self: end;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.6mm;
  }
  .qr-code {
    display: block;
    width: 22mm;
    height: 22mm;
    padding: 1.8mm;
    background: #fff;
    border-radius: 2.6mm;
    box-shadow: 0 0 0 0.6mm rgb(79 216 235 / 0.35);
  }
  .qr-code svg,
  .cta-qr svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .qr-label {
